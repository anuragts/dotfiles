#!/bin/sh

set -eu

usage() {
  cat <<'EOF'
Usage: git discard [-s | -yolo]

Clear local changes in the current Git worktree only.

  -s, --stash    Stash tracked/untracked files and discard ignored files (default)
  -yolo, --yolo  Permanently discard tracked, untracked, and ignored files
  -h, --help     Show this help
EOF
}

mode=stash

case "${1-}" in
  ""|-s|--stash)
    ;;
  -yolo|--yolo)
    mode=yolo
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    printf 'git discard: unknown option: %s\n\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac

if [ "$#" -gt 1 ]; then
  printf 'git discard: expected at most one option\n\n' >&2
  usage >&2
  exit 2
fi

if ! worktree_root=$(git rev-parse --show-toplevel 2>/dev/null); then
  printf 'git discard: not inside a Git worktree\n' >&2
  exit 1
fi

cd "$worktree_root"

# A linked worktree can live inside the current worktree as an untracked
# directory. Exclude those paths so this command never enters or modifies them.
worktree_exclusions=$(mktemp "${TMPDIR:-/tmp}/git-discard.XXXXXX")
trap 'rm -f "$worktree_exclusions"' EXIT HUP INT TERM

git worktree list --porcelain | while IFS= read -r line; do
  case "$line" in
    "worktree $worktree_root/"*)
      printf '%s\n' "${line#worktree "$worktree_root"/}"
      ;;
  esac
done >"$worktree_exclusions"

add_clean_exclusions() {
  while IFS= read -r relative_path; do
    [ -n "$relative_path" ] || continue
    set -- "$@" -e "$relative_path/"
  done <"$worktree_exclusions"
  git clean "$@"
}

if [ "$mode" = "stash" ]; then
  stash_message="git discard: $(date '+%Y-%m-%d %H:%M:%S %z')"

  set -- ':(top)**'
  while IFS= read -r relative_path; do
    [ -n "$relative_path" ] || continue
    set -- "$@" ":(top,exclude)$relative_path" ":(top,exclude)$relative_path/**"
  done <"$worktree_exclusions"

  if ! git stash push --include-untracked --message "$stash_message" -- "$@"; then
    printf 'git discard: stash failed; no destructive fallback was run\n' >&2
    exit 1
  fi
  add_clean_exclusions -qfdx
  printf 'git discard: local changes stashed; ignored files discarded\n'
  exit 0
fi

if git rev-parse --verify HEAD >/dev/null 2>&1; then
  git reset --hard HEAD
fi
add_clean_exclusions -qfdx
printf 'git discard: all local changes permanently discarded\n'
